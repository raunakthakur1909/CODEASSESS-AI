# ──────────────────────────────────────────────────────────────────────
# CodeAssess AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=codeassess_ai
POSTGRES_USER=codeassess
POSTGRES_PASSWORD=

# ── Spring Boot datasource (matches above) ───────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/codeassess_ai
SPRING_DATASOURCE_USERNAME=codeassess
SPRING_DATASOURCE_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
# Must be at least 32 characters for HS256.
JWT_SECRET=

# ── Admin bootstrap (first-run only) ─────────────────────────────────
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_NAME=System Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@codeassess.local
ADMIN_BOOTSTRAP_PASSWORD=

# ── Judge0 (code execution engine) ───────────────────────────────────
# Set JUDGE0_ENABLED=false to use the built-in mock executor (default).
# Set JUDGE0_ENABLED=true and configure the URL to use a real Judge0 instance.
# Self-hosted: https://github.com/judge0/judge0
# Hosted: https://ce.judge0.com (requires API key)
JUDGE0_ENABLED=false
JUDGE0_BASE_URL=http://judge0-server:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# ── Google Gemini AI Review ───────────────────────────────────────────
# Set AI_PROVIDER=mock to disable live reviews (no API key needed).
# Set AI_PROVIDER=gemini and provide AI_API_KEY for live reviews.
AI_REVIEW_ENABLED=true
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-flash-latest

AI_MAX_SOURCE_CODE_LENGTH=100000
AI_MAX_PROMPT_LENGTH=120000
AI_MAX_ATTEMPTS=3
AI_RETRY_DELAY_SECONDS=30
